# Ageiantic Equity Research Platform — environment configuration
#
#   cp .env.example .env
#
# Then fill in the three values marked REQUIRED / STRONGLY RECOMMENDED below. Everything
# else has a working default that matches docker-compose.yml.
#
# This file is committed. `.env` is git-ignored. Never put a real credential in here.

# ======================================================================================
# 1. Identity — REQUIRED
# ======================================================================================

# REQUIRED. Sent as the User-Agent header on every outbound request.
#
# There is deliberately no default. The SEC mandates a descriptive User-Agent that
# identifies the operator as a condition of using its APIs, and a shared placeholder
# would get everyone using it rate-limited or blocked together. Use a real name and a
# real address you monitor.
#
#   AER_HTTP_USER_AGENT="Jane Smith jane@example.com"
AER_HTTP_USER_AGENT=

# ======================================================================================
# 2. Provider credentials — optional here, required at the point of use
# ======================================================================================
# Leave a key blank and the platform still starts; the feature that needs it fails with a
# message naming the variable to set. That way you are never blocked on credentials for a
# provider you are not using yet.

# STRONGLY RECOMMENDED. Nothing that needs a model works without it.
# https://platform.claude.com/settings/keys
AER_ANTHROPIC_API_KEY=

# STRONGLY RECOMMENDED. End-of-day prices and corporate actions for US and UK equities.
# The "All World" plan (about EUR 19.99/month) covers both, under direct exchange
# contracts. https://eodhd.com/pricing
# Without it the platform runs every step and reports price-derived figures as
# unavailable — and the peer step asks no model for a slate, because a peer with no price
# can contribute no multiple (ADR 0059, second amendment).
AER_EODHD_API_KEY=

# Optional, free. US and global macroeconomic series.
# https://fredaccount.stlouisfed.org/apikeys
AER_FRED_API_KEY=

# Optional, free. UK company registry: entity graph, officers, filing history.
# https://developer.company-information.service.gov.uk/
AER_COMPANIES_HOUSE_API_KEY=

# ======================================================================================
# 3. Signing key
# ======================================================================================

# Signs CSRF tokens. There is deliberately no default: a key committed to a repository is
# not a key, because anyone holding the repository could mint a valid token.
#
# Leave it blank for local use and one is generated per process. The only consequence is
# that a form left open across a restart needs reloading. Setting it avoids even that:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# It is REQUIRED when AER_APP_ENV=production, where an ephemeral key would differ between
# workers and change on every deploy. Startup refuses to continue without it.
AER_SECRET_KEY=

# ======================================================================================
# 4. Application
# ======================================================================================

# development | test | production
AER_APP_ENV=development

# CRITICAL | ERROR | WARNING | INFO | DEBUG
AER_LOG_LEVEL=INFO

# JSON logs by default, in every environment, so what you debug looks like what you ship.
# Set to false for human-readable console output while working interactively.
AER_LOG_JSON=true

# Interface the web server binds to. Keep it on loopback. Setting 0.0.0.0 exposes the
# application -- and everything it can reach -- to your entire local network, and logs a
# warning at startup saying so.
AER_BIND_HOST=127.0.0.1
AER_BIND_PORT=8000

# ======================================================================================
# 5. Infrastructure — defaults match docker-compose.yml
# ======================================================================================

# The password below is the local development credential from docker-compose.yml. It is
# not a secret: the port is bound to loopback and the database holds no production data.
# Replace it, here and in AER_POSTGRES_PASSWORD, for anything that is not your own machine.
AER_DATABASE_URL=postgresql+asyncpg://aer:aer_local_dev@127.0.0.1:5432/aer  # pragma: allowlist secret
AER_REDIS_URL=redis://127.0.0.1:6379/0

# Consumed by docker-compose.yml. Change these and AER_DATABASE_URL together.
AER_POSTGRES_USER=aer
AER_POSTGRES_PASSWORD=aer_local_dev
AER_POSTGRES_DB=aer
AER_POSTGRES_PORT=5432
AER_REDIS_PORT=6379

# ======================================================================================
# 6. Storage
# ======================================================================================

# Content-addressed store for every fetched source document. These are the evidence base
# for your reports: back this directory up, and never edit anything inside it by hand.
AER_ARTEFACT_ROOT=./var/artefacts

# Largest single artefact that will be accepted, in bytes. Guards against decompression
# bombs and runaway downloads. Enforced while a response streams in, not after it has
# arrived, so an endless response is abandoned rather than received. Default 50 MiB.
AER_MAX_ARTEFACT_BYTES=52428800

# --- Extraction ---------------------------------------------------------------------------

# The ceiling on a document handed to a parser. Separate from the archive ceiling above
# despite the matching default: archiving a large filing is cheap, and parsing one is where a
# decompression bomb goes off, so the two should be movable independently.
AER_MAX_PARSE_BYTES=52428800

# Wall-clock budget for parsing one document, in seconds. A 300-page annual report takes a
# few; anything reaching this limit is pathological and the child is killed.
AER_PARSE_TIMEOUT_SECONDS=30

# Address-space ceiling for a parse child. Applied on Linux and macOS; Windows has no
# equivalent without a native extension, so there the timeout above is the enforced limit.
# See docs/adr/0017-a-locator-points-into-an-extraction-not-into-bytes.md.
AER_MAX_PARSE_MEMORY_BYTES=1073741824

# Permit the plain http:// scheme for outbound fetches. Leave this false. An unencrypted
# response can be altered in transit, and evidence that may have been altered is not
# evidence.
#
# Note what it does NOT do: the address rules are unaffected, so loopback and private
# addresses remain refused whatever this is set to. It will not make a server on localhost
# reachable.
AER_ALLOW_INSECURE_HTTP=false

# ======================================================================================
# 7. Obsidian
# ======================================================================================
# The generated vault is machine-written and regenerated wholesale. Your personal notes
# must live somewhere else entirely.
#
# Startup refuses to continue if either path contains the other, in either direction --
# nesting one inside the other risks the exporter overwriting your own writing.

# Where generated research notes are written. Leave blank to disable the export.
AER_OBSIDIAN_VAULT_ROOT=

# Your personal notes, including any IMC/CFA study material. Never written to. Declaring
# it here is what lets the containment check protect it.
AER_OBSIDIAN_PERSONAL_ROOT=

# ======================================================================================
# 8. Research defaults
# ======================================================================================

# Point-in-time mode: refuse to use any source published after a request's as-of date.
# On by default. Turning it off invites look-ahead bias, which silently invalidates any
# backward-looking analysis.
AER_POINT_IN_TIME_DEFAULT=true

# ======================================================================================
# 9. Cost control
# ======================================================================================
# Enforced in code, not merely reported. A run projected to exceed its cap pauses for a
# decision rather than quietly spending.

# £12.00 rather than the £2.50 this shipped with. The old figure predated any complete run:
# the first measured one came to a little over £8, £5.17 of it in the drafting step, and it
# was not stopped because that step declared no estimate for the budget guard to read. Now
# that it does, £2.50 would stop every run before it drafts. See ADR 0052 — and tune this,
# it is your money and the right number depends on how many reports a month you want.
AER_PER_RUN_BUDGET_GBP=12.00
AER_MONTHLY_BUDGET_GBP=80.00

# What the watchlist queue may *start* in a month: the runs it commissions count their
# spend, and the ones still alive reserve their caps. Each run keeps the per-run cap and the
# monthly budget applies on top — this bounds commissioning, not spending. See ADR 0107.
AER_WATCHLIST_BUDGET_GBP=30.00

# Warn at this fraction of the monthly budget.
AER_BUDGET_WARN_RATIO=0.75

# USD -> GBP rate used to record costs in sterling. Provider prices are in USD.
AER_USD_TO_GBP=0.79

# The per-custom-section token ceiling. A skill file may ask for less, never more — the
# additive-only composer clamps the request here and says so.
AER_CUSTOM_SECTION_TOKEN_CEILING=12000

# Optional. Adjusts the model routing table, as JSON.
#
# Merged over the defaults rather than replacing them, so you can change one role without
# redeclaring the rest -- and cannot accidentally leave nine roles unrouted.
#
# Roles: planner, source_triage, extraction, analysis, valuation_interpretation,
#        red_team, validator, custom_section, report_writer, obsidian_linker
# Effort: low | medium | high | xhigh | max
#
#   AER_MODEL_ROUTES={"planner":{"model":"claude-opus-5","effort":"max"}}
AER_MODEL_ROUTES=

# Optional. The note's house style, as JSON. Every field it omits keeps its default,
# and it is also editable from the settings page. Presentation only: stored values are
# never restyled (docs/adr/0056).
#
#   prose_money:   "auto" (switch to $bn at the threshold) | "millions" (never scale)
#   billions_from: magnitude at which "auto" prose switches to billions ("1000000000")
#   date_format:   strftime pattern for dates in prose, e.g. "%-d %B %Y"
#   voice:         "impersonal" | "first_person_plural"
#
#   AER_HOUSE_STYLE={"prose_money":"millions","voice":"impersonal"}
AER_HOUSE_STYLE=

# --- Tracing (optional) -----------------------------------------------------------------
# An OTLP/HTTP endpoint to export spans to, e.g. http://127.0.0.1:4318/v1/traces.
# Left empty, no tracing happens at all: no exporter, no background thread, no connection
# attempt. A local install needs no collector. See docs/adr/0049.
AER_OTEL_ENDPOINT=
