{
  "name": "tracework-invest-styles",
  "private": true,
  "description": "Build-time only. Compiles the Tailwind stylesheet; the OUTPUT is committed to src/aer/web/static/css/app.css, so neither CI nor a normal checkout needs Node.",
  "scripts": {
    "build:css": "tailwindcss --input src/aer/web/styles/app.css --output src/aer/web/static/css/app.css --minify",
    "watch:css": "tailwindcss --input src/aer/web/styles/app.css --output src/aer/web/static/css/app.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@ibm/plex-mono-variable": "^1.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "axe-core": "^4.13.0",
    "htmx.org": "^2.0.10",
    "tailwindcss": "^4.3.3"
  }
}
